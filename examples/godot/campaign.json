{
  "apiVersion": "gamefactory.dev/v1",
  "id": "godot-demo",
  "objective": "Improve Pulse Runner's collection, survival, and control balance without breaking its deterministic Godot scenario.",
  "projectRoot": ".",
  "workflow": "autoresearch",
  "requires": [
    "workspace:git.worktree",
    "agent:command.agent",
    "evaluator:godot.scenario"
  ],
  "mutablePaths": ["tuning.json"],
  "immutablePaths": ["addons/gamefactory/**", "campaign.json", "factory.config.json"],
  "parameters": {
    "workspace": "git.worktree",
    "agent": "command.agent",
    "agentCommand": ["node", "tools/tune.mjs"],
    "evaluators": ["godot.scenario"],
    "godot": {
      "importCheck": true,
      "rendered": false,
      "timeoutSeconds": 60,
      "scenario": {
        "provider": "godot.factory/v1",
        "version": "1",
        "path": "res://main.tscn",
        "parameters": { "seed": 7, "ticks": 300, "physics_hz": 60, "duration_seconds": 5 }
      }
    }
  },
  "acceptance": {
    "primaryMetric": "fun_score",
    "direction": "maximize",
    "minimumDelta": 0.005
  },
  "budget": { "maximumExperiments": 3, "maximumConsecutiveCrashes": 2 }
}
