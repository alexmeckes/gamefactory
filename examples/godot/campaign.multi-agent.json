{
  "apiVersion": "gamefactory.dev/v1",
  "id": "godot-multi-agent-demo",
  "objective": "Have specialist teams propose competing deterministic fun_score improvements and select the strongest passing candidate.",
  "projectRoot": ".",
  "workflow": "tournament",
  "requires": [
    "workspace:git.worktree",
    "agent:agent.team",
    "evaluator:godot.scenario"
  ],
  "mutablePaths": ["tuning.json"],
  "immutablePaths": ["addons/gamefactory/**", "campaign*.json", "factory.config.json", "tools/**"],
  "parameters": {
    "tournament": {
      "workspace": "git.worktree",
      "agents": ["agent.team"],
      "evaluators": [{ "id": "godot.scenario", "cost": 10 }],
      "candidateCount": 3,
      "concurrency": 2
    },
    "agentTeam": {
      "maximumParallel": 2,
      "maxOutputCharacters": 12000,
      "scouts": [
        { "id": "systems-scout", "command": ["node", "tools/team-role.mjs"] },
        { "id": "gameplay-scout", "command": ["node", "tools/team-role.mjs"] }
      ],
      "planner": { "id": "lead-planner", "command": ["node", "tools/team-role.mjs"] },
      "implementer": { "id": "builder", "command": ["node", "tools/team-role.mjs"] },
      "critics": [
        { "id": "regression-critic", "command": ["node", "tools/team-role.mjs"] },
        { "id": "quality-critic", "command": ["node", "tools/team-role.mjs"] }
      ]
    },
    "godot": {
      "importCheck": true,
      "rendered": false,
      "timeoutSeconds": 60,
      "scenario": {
        "provider": "godot.factory/v1",
        "version": "1",
        "path": "res://main.tscn",
        "parameters": { "seed": 7, "ticks": 30, "physics_hz": 60 }
      }
    }
  },
  "acceptance": {
    "primaryMetric": "fun_score",
    "direction": "maximize",
    "minimumDelta": 0.01
  },
  "budget": {
    "maximumExperiments": 3,
    "maximumConsecutiveCrashes": 2,
    "wallTimeMinutes": 3
  }
}
