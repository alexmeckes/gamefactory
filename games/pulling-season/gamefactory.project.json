{
  "apiVersion": "gamefactory.dev/v2",
  "kind": "Project",
  "id": "pulling-season",
  "title": "Pulling Season",
  "projectRoot": ".",
  "preproduction": {
    "concept": "concept.md",
    "spec": "game-spec.json",
    "maximumConvergencePasses": 3,
    "attempts": [
      {
        "id": "spec-v1",
        "campaign": "spec-campaign.json",
        "config": "factory.json",
        "status": "superseded"
      },
      {
        "id": "spec-v2",
        "campaign": "spec-campaign-v2.json",
        "config": "factory.json",
        "status": "superseded"
      },
      {
        "id": "spec-v3",
        "campaign": "spec-campaign-v3.json",
        "config": "factory.json"
      }
    ]
  },
  "slices": [
    {
      "id": "first-playable",
      "title": "One embodied oversized-crop harvest",
      "order": 10,
      "consumesClaims": ["loop.core"],
      "playerOutcome": "Read one oversized crop and its soil, commit to a safer-now or riskier-later harvest plan, physically extract it through shipping input, understand why it emerged intact or damaged, and immediately face another harvest-plan decision informed by that result.",
      "primaryRisk": "The slice presents crop cues and labels but resolves the harvest with a context prompt, scripted animation, opaque randomness, invisible state change, or nonpersistent reward instead of a causal physical wager.",
      "nonGoals": [
        "Networking or cooperative play",
        "Production art or imitation of another game's assets",
        "A calendar, broad inventory, crafting tree, or economy",
        "Multiple fields or a crop catalog",
        "Long-term progression"
      ],
      "mutablePaths": [
        "Assets/**",
        "ProjectSettings/**",
        "Packages/packages-lock.json",
        "design/**",
        "evidence/**"
      ],
      "evidence": {
        "scenarios": ["early-human-controls", "late-human-controls", "late-recovery-human-controls"],
        "requireInteractionTrace": true,
        "requireEmbodiedGameplay": true,
        "requireEngineCapture": true,
        "requireMotionEvidence": true
      },
      "attemptPolicy": {
        "executionRetries": 2,
        "creativeRepairs": 2,
        "specAmendments": 1,
        "advisorEscalations": 1
      },
      "gate": {
        "requireAcceptedRevision": true,
        "requireHumanApproval": true,
        "allowBudgetExhaustedAfterAcceptance": true
      },
      "attempts": [
        {
          "id": "embodied-v18",
          "campaign": "embodied-campaign.json",
          "config": "factory.json",
          "status": "superseded"
        },
        {
          "id": "gameplay-gauntlet-v1",
          "campaign": "gameplay-gauntlet.json",
          "config": "factory.json"
        }
      ]
    },
    {
      "id": "production-encounter",
      "title": "Authored harvest encounter",
      "order": 20,
      "dependsOn": ["first-playable"],
      "consumesClaims": ["loop.core", "visual.production-fidelity"],
      "playerOutcome": "Replay the human-approved harvest as a coherent, original production encounter whose crop, soil, hands, motion, sound, interface, physical consequence, and next decision remain readable at the shipping camera.",
      "primaryRisk": "Production polish becomes a pile of disconnected assets, hides or regresses the accepted physical harvest, imitates protected reference content, or is accepted from still images without fresh engine play evidence.",
      "nonGoals": [
        "A complete crop catalog or multi-hour progression system",
        "Networking or cooperative play",
        "Copying another game's protected characters, props, layouts, branding, or assets",
        "Polishing screens and systems outside the approved encounter",
        "Treating automated scores as human evidence of fun"
      ],
      "mutablePaths": [
        "Assets/**",
        "ProjectSettings/**",
        "Packages/packages-lock.json",
        "design/**",
        "evidence/**"
      ],
      "evidence": {
        "scenarios": ["early-human-controls", "late-human-controls", "late-recovery-human-controls"],
        "requireInteractionTrace": true,
        "requireEmbodiedGameplay": true,
        "requireEngineCapture": true,
        "requireMotionEvidence": true,
        "targetApprovalNode": "scene-target-gate",
        "requireRuntimeAssets": [
          "environment-lighting-materials",
          "crop-soil-props",
          "hands-camera-motion",
          "effects-audio",
          "interface-accessibility"
        ]
      },
      "attemptPolicy": {
        "executionRetries": 2,
        "creativeRepairs": 3,
        "specAmendments": 1,
        "advisorEscalations": 1
      },
      "gate": {
        "requireAcceptedRevision": true,
        "requireHumanApproval": true,
        "allowBudgetExhaustedAfterAcceptance": true
      },
      "attempts": [
        {
          "id": "production-gauntlet-v1",
          "campaign": "production-gauntlet.json",
          "config": "factory.json"
        }
      ]
    }
  ]
}
