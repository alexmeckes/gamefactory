{
  "apiVersion": "gamefactory.dev/v1",
  "id": "pulling-season-spec-v4",
  "objective": "Validate and preserve the user-amended Pulling Season GameSpec revision 2 that rejects the automation-shaped prototype, requires a human-playable gameplay Gauntlet, and makes the downstream production encounter explicit. Preserve the exact frozen revision-1 supersedes fingerprint 4bed95d52588a6291310fec511ffec21b702817d9f3361defbfcd97dc2c3054c. Do not reopen accepted product direction unless the current frozen specification is invalid.",
  "projectRoot": ".",
  "workflow": "autoresearch",
  "requires": [
    "workflow:autoresearch",
    "workspace:git.worktree",
    "agent:agent.team",
    "evaluator:game.spec"
  ],
  "mutablePaths": ["game-spec.json"],
  "immutablePaths": [
    "concept.md",
    "gamefactory.project.json",
    "contracts/**",
    "Packages/manifest.json",
    "gameplay-gauntlet.json",
    "production-gauntlet.json",
    ".git/**",
    ".factory/**"
  ],
  "parameters": {
    "resume": {
      "projectRevisionCarryForwardPaths": [
        "extensions/agent-team/README.md",
        "extensions/agent-team/src/agent-team.test.ts",
        "extensions/agent-team/src/index.ts",
        "extensions/tournament/src/index.ts",
        "extensions/tournament/src/integration.test.ts",
        "packages/core/src/core.test.ts",
        "packages/core/src/runner.ts",
        "packages/core/src/types.ts",
        "games/pulling-season/evidence/gameplay-gauntlet-v5-recovery.md",
        "games/pulling-season/evidence/gameplay-gauntlet-v7-pivot.md",
        "games/pulling-season/gamefactory.project.json",
        "games/pulling-season/gameplay-gauntlet.json",
        "games/pulling-season/production-gauntlet.json",
        "games/pulling-season/spec-campaign-v3.json"
      ]
    },
    "workspace": "git.worktree",
    "agent": "agent.team",
    "evaluators": ["game.spec"],
    "autoresearch": {"stopAfterAccepted": true},
    "gameSpec": {
      "path": "game-spec.json",
      "conceptPath": "concept.md",
      "projectId": "pulling-season",
      "requireFrozen": true,
      "requiredClaims": ["loop.core", "visual.production-fidelity"],
      "requiredSlices": ["first-playable", "production-encounter"],
      "maximumConvergencePasses": 3
    },
    "agentTeam": {
      "provider": "openai-codex-app-server",
      "billingMode": "subscription",
      "threadRetention": "ephemeral",
      "maximumParallel": 2,
      "maxOutputCharacters": 18000,
      "handoffCharacters": 7000,
      "historyLimit": 2,
      "graph": {
        "enforceWriteContracts": true,
        "reuseCheckpoints": true,
        "maximumTotalAttempts": 5,
        "nodes": [
          {
            "id": "spec-owner",
            "skills": ["converge-game-spec", "frame-core-game"],
            "adapter": "codex-app-server",
            "role": "planner",
            "permissions": "write",
            "authority": "mutate-spec",
            "writePaths": ["game-spec.json"],
            "model": "gpt-5.6-sol",
            "reasoningEffort": "xhigh",
            "maximumAttempts": 1,
            "instructions": "Only if deterministic validation rejects the current frozen file, make the smallest valid amendment. Preserve the concept verbatim, revision 2, the exact frozen revision-1 supersedes fingerprint 4bed95d52588a6291310fec511ffec21b702817d9f3361defbfcd97dc2c3054c, the user's direct rejection evidence, required loop.core and visual.production-fidelity claims, the gameplay and production slices, and the decision that human play owns controls, comprehension, feel, and fun. Do not reset revision 2 to the original graybox scope or imitate protected reference content."
          },
          {
            "id": "spec-critic",
            "skills": ["converge-game-spec"],
            "adapter": "codex-app-server",
            "role": "critic",
            "permissions": "read",
            "authority": "approve",
            "model": "gpt-5.6-sol",
            "reasoningEffort": "high",
            "dependsOn": ["spec-owner"],
            "requiredOutputFields": ["outcome", "summary"],
            "instructions": "Stress-test the amended GameSpec for attributable user evidence, embodied agency, meaningful counterfactual plans, human acceptance before production, original production direction, bounded scope, and exact revision lineage against frozen revision 1 fingerprint 4bed95d52588a6291310fec511ffec21b702817d9f3361defbfcd97dc2c3054c. Block only by citing an existing claim and do not treat desirable extra systems as requirements.",
            "repair": {
              "target": "spec-owner",
              "outcomes": ["revise"],
              "maximumAttempts": 2,
              "allowedPaths": ["game-spec.json"]
            }
          }
        ]
      }
    }
  },
  "acceptance": {
    "primaryMetric": "spec_valid",
    "direction": "maximize",
    "minimumDelta": 0,
    "comparison": "at-least",
    "hardGates": ["game.spec"]
  },
  "budget": {
    "maximumExperiments": 2,
    "maximumConsecutiveCrashes": 2,
    "wallTimeMinutes": 45
  }
}
