{
  "apiVersion": "gamefactory.sam3/v1",
  "model": "sam3",
  "modelSource": "facebook/sam3",
  "backend": "transformers",
  "device": "cuda",
  "precision": "bfloat16",
  "jobs": [
    {
      "id": "bastion-cap",
      "sourcePath": "design/sprite-atlas-source.png",
      "prompt": "red capped mushroom warrior holding a round wooden shield",
      "outputDirectory": "assets/generated/bastion-cap",
      "threshold": 0.35,
      "maxInstances": 1,
      "cropPaddingPixels": 6,
      "maskExpandPixels": 1,
      "maskFeatherPixels": 0
    },
