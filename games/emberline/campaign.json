{
  "apiVersion": "gamefactory.dev/v1",
  "id": "emberline-vertical-slice",
  "objective": "Build a polished, compact Godot tower-defense vertical slice where three workshop instruments create readable thermal reactions along one living fuse, culminating in a memorable furnace-warden boss.",
  "projectRoot": ".",
  "workflow": "tournament",
  "requires": [
    "workspace:git.worktree",
    "agent:agent.team",
    "evaluator:design.system",
    "evaluator:godot.visual",
    "evaluator:godot.scenario"
  ],
  "mutablePaths": [
    "project.godot",
    "main.tscn",
    "main.gd",
    "README.md",
    "src/**",
    "levels/**",
    "assets/**",
    "audio/**",
    "design/**",
    "DESIGN_SYSTEM.md",
    "design-system.json"
  ],
  "immutablePaths": [
    "AGENTS.md",
    "GAME.md",
    "STYLE.md",
    "visual-direction.json",
    "visual-reference/**",
    "campaign.json",
    "factory.config.json",
    "addons/gamefactory/**"
  ],
  "parameters": {
    "tournament": {
      "workspace": "git.worktree",
      "agents": ["agent.team"],
      "evaluators": [
        {"id":"design.system", "cost":1},
        {"id":"godot.visual", "cost":2},
        {"id":"godot.scenario", "cost":10}
      ],
      "candidateCount": 2,
      "concurrency": 2,
      "director": {
        "agent": "agent.team",
        "model": "gpt-5.6-sol",
        "reasoningEffort": "high",
        "advisorReasoningEffort": "xhigh",
        "timeoutSeconds": 2400,
        "maxOutputCharacters": 30000
      }
    },
    "agentTeam": {
      "maximumParallel": 3,
      "maxOutputCharacters": 30000,
      "handoffCharacters": 10000,
      "historyLimit": 4,
      "provider": "openai-codex-app-server",
      "billingMode": "subscription",
      "graph": {
        "maximumTotalAttempts": 32,
        "maximumRepairAttempts": 2,
        "context": [
          {"path":"GAME.md", "kind":"other", "mediaType":"text/markdown", "label":"Product brief"},
          {"path":"STYLE.md", "kind":"other", "mediaType":"text/markdown", "label":"Style direction"},
          {"path":"visual-direction.json", "kind":"other", "mediaType":"application/json", "label":"Visual quality contract"},
          {"path":"visual-reference/art-target.png", "kind":"image", "mediaType":"image/png", "label":"Aspirational workshop art target"},
          {"path":"visual-reference/baseline-title.png", "kind":"image", "mediaType":"image/png", "label":"Unpolished title baseline"},
          {"path":"visual-reference/baseline-board.png", "kind":"image", "mediaType":"image/png", "label":"Unpolished board baseline"},
          {"path":"visual-reference/baseline-wave.png", "kind":"image", "mediaType":"image/png", "label":"Unpolished combat baseline"},
          {"path":"main.gd", "kind":"other", "mediaType":"text/plain", "label":"Playable baseline"}
        ],
        "nodes": [
          {
            "id":"systems-scout",
            "adapter":"codex-app-server",
            "model":"gpt-5.6-sol",
            "reasoningEffort":"high",
            "role":"scout",
            "permissions":"read",
            "inheritContext":false,
            "instructions":"Explore three-tower thermal-combo grammars, enemy counterplay, wave pacing, and meaningful upgrade choices for an eight-to-twelve-minute vertical slice. Preserve the one-fuse identity. Propose a bounded but surprising candidate, not a generic genre checklist."
          },
          {
            "id":"feel-scout",
            "adapter":"codex-app-server",
            "model":"gpt-5.6-luna",
            "reasoningEffort":"high",
            "advisor":{"model":"gpt-5.6-sol", "reasoningEffort":"high", "outcomes":["needs_advisor"], "onFailure":true, "maximumAttempts":1},
            "role":"scout",
            "permissions":"read",
            "instructions":"Explore tactile placement, attack anticipation, reaction feedback, readable combat density, accessibility, onboarding, and the smallest useful audio vocabulary. Identify how the game can feel authored and juicy without hiding tactical state."
          },
          {
            "id":"encounter-scout",
            "adapter":"codex-app-server",
            "model":"gpt-5.6-luna",
            "reasoningEffort":"high",
            "advisor":{"model":"gpt-5.6-sol", "reasoningEffort":"high", "outcomes":["needs_advisor"], "onFailure":true, "maximumAttempts":1},
            "role":"scout",
            "permissions":"read",
            "inheritContext":false,
            "instructions":"Develop contrasting wave arcs and a furnace-warden finale that force the player to reinterpret the same three instruments. Seek one memorable systemic twist that fits the existing compact Godot architecture."
          },
          {
            "id":"design-system-director",
            "adapter":"codex-app-server",
            "model":"gpt-5.6-sol",
            "reasoningEffort":"xhigh",
            "timeoutSeconds":1200,
            "role":"planner",
            "permissions":"read",
            "dependsOn":["systems-scout", "feel-scout", "encounter-scout"],
            "instructions":"Act as Design System Director. Audit the committed DESIGN_SYSTEM.md, design-system.json, Godot Theme, ImageGen studies, pinned target, and current implementation. Identify a small set of high-leverage gaps and safe semantic extensions; do not regenerate the same reference studies for every tournament candidate. Recommend targeted ImageGen or SAM3 asset work only where code-native rendering cannot reach the intended craft. Preserve creative latitude through semantic roles rather than frozen layouts."
          },
          {
            "id":"visual-director",
            "adapter":"codex-app-server",
            "model":"gpt-5.6-sol",
            "reasoningEffort":"xhigh",
            "timeoutSeconds":1800,
            "role":"planner",
            "permissions":"read",
            "dependsOn":["design-system-director"],
            "instructions":"Inspect the authored design system, both ImageGen studies, pinned target, and baseline captures with image-aware tools. Translate them into a bounded art hierarchy for this Godot build. Diagnose material separation, lighting, composition, enemy/tower readability, typography, prop craft, and motion. Preserve the system without literally copying reference layouts. Return ready with prioritized findings and an implementation brief."
          },
          {
            "id":"systems-planner",
            "adapter":"codex-app-server",
            "model":"gpt-5.6-sol",
            "reasoningEffort":"high",
            "timeoutSeconds":1200,
            "role":"planner",
            "permissions":"read",
            "inheritContext":false,
            "dependsOn":["systems-scout", "feel-scout", "encounter-scout"],
            "instructions":"Synthesize one opinionated systems plan: combat grammar, teaching sequence, four-wave arc, boss twist, interaction contract, economy, deterministic evidence, and a bounded implementation plan. Keep presentation hooks semantic so a later visual specialist has room to explore."
          },
          {
            "id":"systems-builder",
            "adapter":"codex-app-server",
            "model":"gpt-5.6-sol",
            "reasoningEffort":"high",
            "timeoutSeconds":2400,
            "role":"implementer",
            "permissions":"write",
            "inheritContext":false,
            "dependsOn":["systems-planner"],
            "instructions":"Implement and verify the playable systems slice before visual polish. Keep title, build, four-wave, boss, victory/defeat/replay flows; make placement, reactions, economy, upgrades, and deterministic hooks correct and legible. Prefer extracting systems into src/ where practical. Preserve presentation seams for the visual specialist; do not spend the run on decorative polish."
          },
          {
            "id":"contract-gate",
            "adapter":"command",
            "command":["C:\\Users\\alexm\\OneDrive\\Documents\\New project\\oldschool-mmo-godot\\tools\\godot\\Godot_v4.7.1-stable_win64_console.exe", "--disable-crash-handler", "--headless", "--path", ".", "--script", "res://addons/gamefactory/contract_runner.gd"],
            "role":"worker",
            "permissions":"read",
            "inheritContext":false,
            "dependsOn":["systems-builder"],
            "refreshAfterRepair":true,
            "instructions":"Run the cheap engine-native load, fixture, fire, and telemetry contract before expensive polish."
          },
          {
            "id":"systems-critic",
            "adapter":"codex-app-server",
            "model":"gpt-5.6-sol",
            "reasoningEffort":"high",
            "timeoutSeconds":1500,
            "role":"critic",
            "permissions":"read",
            "inheritContext":false,
            "dependsOn":["systems-builder", "contract-gate"],
            "instructions":"Inspect and test for strategic degeneracy, unusable placement/upgrade flow, reaction bugs, stuck waves, boss failures, reset/progression bugs, boundary violations, and dishonest metrics. Return pass or revise with concrete evidence.",
            "repair":{"target":"systems-builder", "outcomes":["revise"], "maximumAttempts":1, "allowedPaths":["main.gd", "src/**", "levels/**"], "preserve":["contract-gate"]}
          },
          {
            "id":"integration-planner",
            "adapter":"codex-app-server",
            "model":"gpt-5.6-sol",
            "reasoningEffort":"high",
            "timeoutSeconds":1200,
            "role":"planner",
            "permissions":"read",
            "dependsOn":["systems-critic", "visual-director"],
            "instructions":"Turn the passed systems slice and the visual direction into one bounded polish brief. Identify presentation seams, required motion beats, hierarchy, material layers, typography, props, audio, and accessibility. Do not reopen passed systems decisions without concrete evidence."
          },
          {
            "id":"visual-polisher",
            "adapter":"codex-app-server",
            "model":"gpt-5.6-sol",
            "reasoningEffort":"xhigh",
            "timeoutSeconds":3000,
            "role":"implementer",
            "permissions":"write",
            "dependsOn":["integration-planner"],
            "instructions":"Apply a cohesive authored visual and feel pass to the already working slice. Implement the design system through code-native Godot layers and project assets: material depth, composition, typography, lighting, tower/enemy silhouettes, anticipation, projectile travel, impact, settle, audio, and accessibility. Preserve runtime contracts and deterministic hooks. Finish a small number of high-leverage surfaces instead of adding unused framework."
          },
          {
            "id":"runtime-contract",
            "adapter":"command",
            "command":["C:\\Users\\alexm\\OneDrive\\Documents\\New project\\oldschool-mmo-godot\\tools\\godot\\Godot_v4.7.1-stable_win64_console.exe", "--disable-crash-handler", "--headless", "--path", ".", "--script", "res://addons/gamefactory/contract_runner.gd"],
            "role":"worker",
            "permissions":"read",
            "inheritContext":false,
            "dependsOn":["systems-builder", "visual-polisher"],
            "refreshAfterRepair":true,
            "instructions":"Re-run the cheap runtime contract after polish and every repair."
          },
          {
            "id":"visual-capture",
            "adapter":"command",
            "command":["C:\\Users\\alexm\\OneDrive\\Documents\\New project\\oldschool-mmo-godot\\tools\\godot\\Godot_v4.7.1-stable_win64_console.exe", "--disable-crash-handler", "--path", ".", "--script", "res://addons/gamefactory/capture_runner.gd"],
            "role":"worker",
            "permissions":"read",
            "inheritContext":false,
            "dependsOn":["systems-builder", "visual-polisher", "runtime-contract"],
            "refreshAfterRepair":true,
            "instructions":"Capture deterministic title, board, live wave, and seven-frame attack/reaction evidence from the running Godot project."
          },
          {
            "id":"visual-experience-critic",
            "adapter":"codex-app-server",
            "model":"gpt-5.6-sol",
            "reasoningEffort":"xhigh",
            "timeoutSeconds":1800,
            "role":"critic",
            "permissions":"read",
            "dependsOn":["systems-builder", "visual-polisher", "visual-capture", "runtime-contract"],
            "refreshAfterRepair":true,
            "instructions":"Act as a strict visual/experience director. Inspect every still and the complete seven-frame motion sequence with image-aware tools. Compare observable craft against the pinned target, baselines, STYLE.md, visual-direction.json, and design system. Pass only if the contract clears; otherwise return one small prioritized repair brief. Always return findings.scorecard numeric 0-100 for material_depth, focal_hierarchy, combat_legibility, authored_specificity, composition_typography, motion_feedback. Always return findings.evidence with one object per required view containing view, path, and a concrete observation, plus one object with sequence tower-fire and a concrete temporal observation, plus findings.blockingIssues. Never inflate scores or call it fun without human playtest.",
            "repair":{"target":"visual-polisher", "outcomes":["revise"], "maximumAttempts":1, "allowedPaths":["project.godot", "main.tscn", "main.gd", "src/**", "assets/**", "audio/**", "design/**", "DESIGN_SYSTEM.md", "design-system.json"], "preserve":["runtime-contract"]}
          }
        ]
      }
    },
    "godot": {
      "binary":"C:\\Users\\alexm\\OneDrive\\Documents\\New project\\oldschool-mmo-godot\\tools\\godot\\Godot_v4.7.1-stable_win64_console.exe",
      "importCheck":true,
      "rendered":false,
      "timeoutSeconds":180,
      "scenario": {
        "provider":"godot.factory/v1",
        "version":"1",
        "path":"res://main.tscn",
        "parameters":{"seed":271828, "ticks":900, "physics_hz":60, "duration_seconds":15}
      },
      "visualReview": {
        "reviewNode":"visual-experience-critic",
        "minimumScore":72,
        "minimumDimensionScore":55,
        "minimumWidth":960,
        "minimumHeight":600,
        "requiredDimensions":["material_depth", "focal_hierarchy", "combat_legibility", "authored_specificity", "composition_typography", "motion_feedback"],
        "requiredViews":[
          {"id":"title", "path":".factory/previews/title.png", "baselineSha256":"5907db64e9c60efa2db21e1fcea69362947062ab02575ec9d5f3765e2576d34f"},
          {"id":"board", "path":".factory/previews/board.png", "baselineSha256":"1f2ec84068243ab133675fec23e41d72d37e92576b8fae48d5dbf54cff26e29e"},
          {"id":"wave", "path":".factory/previews/wave.png", "baselineSha256":"f61db7f848f0029a05d1df034a57dd2be1cc532b4d96368756814e21c0a24628"}
        ],
        "requiredSequences":[
          {"id":"tower-fire", "paths":[".factory/previews/motion-000.png", ".factory/previews/motion-001.png", ".factory/previews/motion-002.png", ".factory/previews/motion-003.png", ".factory/previews/motion-004.png", ".factory/previews/motion-005.png", ".factory/previews/motion-006.png"], "minimumFrames":7}
        ]
      }
    },
    "designSystem": {
      "path":"design-system.json",
      "requiredTokenGroups":["color", "typography", "spacing", "material", "motion", "audio", "accessibility"],
      "requiredAdapters":["godot-theme"],
      "minimumReferences":2,
      "requireImagegenReference":true
    }
  },
  "acceptance":{"primaryMetric":"visual_quality", "direction":"maximize", "minimumDelta":5},
  "budget":{"maximumExperiments":2, "maximumConsecutiveCrashes":2, "wallTimeMinutes":210}
}
