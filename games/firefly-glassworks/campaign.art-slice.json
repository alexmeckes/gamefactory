{
  "apiVersion": "gamefactory.dev/v1",
  "id": "firefly-art-slice-selection",
  "objective": "Select one engine-feasible production-quality visual method for the accepted Firefly Glassworks gameplay loop by finishing only a representative puzzle slice.",
  "projectRoot": ".",
  "workflow": "tournament",
  "requires": ["workspace:git.worktree", "agent:agent.team", "evaluator:design.system", "evaluator:godot.visual", "evaluator:godot.scenario"],
  "optional": ["agent:sam3.segment", "agent:asset.command"],
  "mutablePaths": ["project.godot", "main.tscn", "main.gd", "README.md", "src/**", "levels/**", "assets/**", "audio/**", "design/**", "DESIGN_SYSTEM.md", "design-system.json", "sam3.request.json"],
  "immutablePaths": ["AGENTS.md", "GAME.md", "STYLE.md", "visual-direction.json", "visual-reference/**", "campaign.*.json", "factory.*.json", "addons/gamefactory/**"],
  "parameters": {
    "tournament": {
      "workspace":"git.worktree",
      "agents":["agent.team"],
      "evaluators":[{"id":"design.system", "cost":1}, {"id":"godot.visual", "cost":2}, {"id":"godot.scenario", "cost":10}],
      "candidateCount":2,
      "concurrency":2,
      "director":{"agent":"agent.team", "model":"gpt-5.6-sol", "reasoningEffort":"high", "advisorReasoningEffort":"xhigh", "timeoutSeconds":1800, "maxOutputCharacters":30000}
    },
    "agentTeam": {
      "maximumParallel":3,
      "maxOutputCharacters":30000,
      "handoffCharacters":10000,
      "historyLimit":3,
      "provider":"openai-codex-app-server",
      "billingMode":"subscription",
      "graph": {
        "maximumTotalAttempts":24,
        "maximumRepairAttempts":1,
        "context":[
          {"path":"GAME.md", "kind":"other", "mediaType":"text/markdown", "label":"Product brief"},
          {"path":"STYLE.md", "kind":"other", "mediaType":"text/markdown", "label":"Lightweight direction"},
          {"path":"visual-direction.json", "kind":"other", "mediaType":"application/json", "label":"Typed visual contract"},
          {"path":"visual-reference/baseline-first-puzzle.png", "kind":"image", "mediaType":"image/png", "label":"Deliberately unstyled gameplay baseline"},
          {"path":"visual-reference/baseline-solved.png", "kind":"image", "mediaType":"image/png", "label":"Deliberately unstyled solved-state baseline"},
          {"path":"main.gd", "kind":"other", "mediaType":"text/plain", "label":"Accepted gameplay implementation"}
        ],
        "nodes":[
          {
            "id":"art-director", "adapter":"codex-app-server", "model":"gpt-5.6-sol", "reasoningEffort":"xhigh", "timeoutSeconds":1500, "role":"planner", "permissions":"read",
            "instructions":"Inspect the accepted gameplay loop at its shipping camera. Propose one bounded visual hypothesis for a quiet glass workshop, identifying hierarchy, material contrast, typography, beam language, interaction states, and what must remain plain. Do not plan the complete asset library and do not introduce standalone concept art as a gameplay target."
          },
          {
            "id":"asset-method-scout", "adapter":"codex-app-server", "model":"gpt-5.6-luna", "reasoningEffort":"high", "role":"scout", "permissions":"read",
            "advisor":{"model":"gpt-5.6-sol", "reasoningEffort":"high", "outcomes":["needs_advisor"], "onFailure":true, "maximumAttempts":1},
            "instructions":"Compare feasible production methods for this exact Godot slice: authored vector/mesh work, ImageGen-derived layered sprites, SAM3-assisted cutouts, shaders, lighting, particles, and typography. Recommend only what improves the representative interaction at gameplay scale; identify cost, reuse, provenance, and failure modes."
          },
          {
            "id":"slice-planner", "adapter":"codex-app-server", "model":"gpt-5.6-sol", "reasoningEffort":"high", "timeoutSeconds":1200, "role":"planner", "permissions":"read", "inheritContext":false,
            "dependsOn":["art-director", "asset-method-scout"],
            "instructions":"Define the vertical art slice: one puzzle board region, source, receiver, manipulable instrument family, living beam, one transformation/contact, minimal interaction chrome, and a complete motion beat. Specify reusable resources, capture conditions, explicit omissions, and the evidence required to call the method production-feasible."
          },
          {
            "id":"slice-builder", "adapter":"codex-app-server", "model":"gpt-5.6-sol", "reasoningEffort":"xhigh", "timeoutSeconds":3600, "role":"implementer", "permissions":"write",
            "dependsOn":["slice-planner"],
            "instructions":"Build only the representative art slice in the accepted playable project. Use the installed ImageGen skill, SAM3 extension/runtime, or engine-native construction when they materially help; preserve exact source prompts and provenance. Finish the representative puzzle, living beam, one transformation, one control surface, and the seven-frame motion sequence at the shipping camera. Preserve gameplay contracts. Run the capture and copy the representative running-engine screenshot to design/references/firefly-production-slice.png. Author DESIGN_SYSTEM.md and design-system.json at maturity production-slice with semantic tokens and patterns; references declare purpose and authority, and only the running capture uses authority production-target/source captured. Create design/production-slice.json describing the camera, actual resources, implemented surfaces, deliberate omissions, source capture, and reuse constraints; register it as adapter godot-production-slice with exact hashes. Do not finish every level, title, ending, or asset variant."
          },
          {
            "id":"slice-contract", "adapter":"command", "command":["C:\\Users\\alexm\\OneDrive\\Documents\\New project\\oldschool-mmo-godot\\tools\\godot\\Godot_v4.7.1-stable_win64_console.exe", "--disable-crash-handler", "--headless", "--path", ".", "--script", "res://addons/gamefactory/contract_runner.gd"],
            "role":"worker", "permissions":"read", "inheritContext":false, "dependsOn":["slice-builder"], "refreshAfterRepair":true,
            "instructions":"Run the gameplay contract after the art slice and every repair."
          },
          {
            "id":"slice-capture", "adapter":"command", "command":["C:\\Users\\alexm\\OneDrive\\Documents\\New project\\oldschool-mmo-godot\\tools\\godot\\Godot_v4.7.1-stable_win64_console.exe", "--disable-crash-handler", "--path", ".", "--script", "res://addons/gamefactory/capture_runner.gd"],
            "role":"worker", "permissions":"read", "inheritContext":false, "dependsOn":["slice-builder", "slice-contract"], "refreshAfterRepair":true,
            "instructions":"Capture the running representative puzzle, solved state, and seven-frame beam sequence."
          },
          {
            "id":"gameplay-regression", "adapter":"codex-app-server", "model":"gpt-5.6-sol", "reasoningEffort":"high", "timeoutSeconds":1200, "role":"critic", "permissions":"read", "inheritContext":false,
            "dependsOn":["slice-builder", "slice-contract"], "refreshAfterRepair":true,
            "instructions":"Confirm the selected gameplay loop, solvability, direct manipulation, progression, reset, deterministic hooks, and honest telemetry survived the art work. This is a regression gate, not permission to redesign the loop."
          },
          {
            "id":"art-slice-critic", "adapter":"codex-app-server", "model":"gpt-5.6-sol", "reasoningEffort":"xhigh", "timeoutSeconds":1800, "role":"critic", "permissions":"read",
            "dependsOn":["slice-builder", "slice-contract", "slice-capture", "gameplay-regression"], "refreshAfterRepair":true,
            "instructions":"Inspect the two required stills and complete beam sequence with image-aware tools. Gate material separation, focal hierarchy, beam legibility, authored specificity, typography/composition, motion, accessibility, engine feasibility, and reuse. The seed captures are baselines, not targets. Pass only if this small slice looks authored at gameplay scale and its resources can expand; never require out-of-scope screens or claim fun. Return findings.scorecard numeric 0-100 for material_depth, focal_hierarchy, beam_legibility, authored_specificity, composition_typography, motion_feedback; findings.evidence for first-puzzle, solved, and sequence beam-route; and findings.blockingIssues.",
            "repair":{"target":"slice-builder", "outcomes":["revise"], "maximumAttempts":1, "allowedPaths":["project.godot", "main.tscn", "main.gd", "README.md", "src/**", "levels/**", "assets/**", "audio/**", "design/**", "DESIGN_SYSTEM.md", "design-system.json", "sam3.request.json"], "preserve":["gameplay-regression"]}
          }
        ]
      }
    },
    "godot": {
      "binary":"C:\\Users\\alexm\\OneDrive\\Documents\\New project\\oldschool-mmo-godot\\tools\\godot\\Godot_v4.7.1-stable_win64_console.exe",
      "importCheck":true, "rendered":false, "timeoutSeconds":180,
      "scenario":{"provider":"godot.factory/v1", "version":"1", "path":"res://main.tscn", "parameters":{"seed":161803, "ticks":900, "physics_hz":60, "duration_seconds":15}},
      "visualReview": {
        "reviewNode":"art-slice-critic", "minimumScore":70, "minimumDimensionScore":52, "minimumWidth":960, "minimumHeight":600,
        "requiredDimensions":["material_depth", "focal_hierarchy", "beam_legibility", "authored_specificity", "composition_typography", "motion_feedback"],
        "requiredViews":[
          {"id":"first-puzzle", "path":".factory/previews/first-puzzle.png", "baselineSha256":"529505fe0a0a17efcc491fa197290a2268f0e8006f28f8eb2fe26e4113d9ea12"},
          {"id":"solved", "path":".factory/previews/solved.png", "baselineSha256":"560bb85d30ed1c9d09e88ef88a31cf40ec3d88e530b1604f59c091cf65900ca0"}
        ],
        "requiredSequences":[{"id":"beam-route", "paths":[".factory/previews/motion-000.png", ".factory/previews/motion-001.png", ".factory/previews/motion-002.png", ".factory/previews/motion-003.png", ".factory/previews/motion-004.png", ".factory/previews/motion-005.png", ".factory/previews/motion-006.png"], "minimumFrames":7}]
      }
    },
    "designSystem": {
      "path":"design-system.json", "visualDirectionPath":"visual-direction.json", "minimumMaturity":"production-slice",
      "requiredTokenGroups":["color", "typography", "spacing", "material", "motion", "accessibility"],
      "requiredAdapters":["godot-production-slice"], "requiredReferenceAuthorities":["production-target"], "minimumReferences":1, "requireImagegenReference":false
    },
    "sam3": {
      "requestPath":"sam3.request.json",
      "command":["D:/GameFactory/runtimes/sam3/venv/Scripts/python.exe", "{worker}"],
      "doctorCommand":["D:/GameFactory/runtimes/sam3/venv/Scripts/python.exe", "{worker}", "--doctor"],
      "modelSource":"facebook/sam3", "backend":"transformers", "device":"cuda", "precision":"bfloat16", "timeoutSeconds":900
    }
  },
  "acceptance":{"primaryMetric":"visual_quality", "direction":"maximize", "minimumDelta":5},
  "budget":{"maximumExperiments":2, "maximumConsecutiveCrashes":2, "wallTimeMinutes":150}
}
