; Wickward production slice
config_version=5

[application]
config/name="Wickward"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

[input]
start_battle={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":32)]}
reset_round={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":82)]}
